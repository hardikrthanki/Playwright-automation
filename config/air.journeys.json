{
  "businessJourneys": [
    {
      "name": "Registration",
      "patterns": ["onboarding", "register", "signup"],
      "modules": ["Signup"],
      "critical": true
    },
    {
      "name": "Authentication",
      "patterns": ["login", "auth", "forgot password", "unlock account"],
      "modules": ["Authentication"],
      "critical": true
    },
    {
      "name": "Access Control",
      "patterns": ["permission", "access control", "rbac", "restricted user", "allowed user", "protected route", "unauthenticated user", "direct access", "blocks direct access"],
      "modules": ["Access Control"],
      "critical": true
    },
    {
      "name": "Profile Setup",
      "patterns": ["profile"],
      "modules": ["Profile"],
      "critical": false
    },
    {
      "name": "Risk Profile",
      "patterns": ["risk"],
      "modules": ["Onboarding"],
      "critical": true
    },
    {
      "name": "Compliance",
      "patterns": ["compliance"],
      "modules": ["Onboarding"],
      "critical": true
    },
    {
      "name": "Subscription",
      "patterns": [
        "subscriber",
        "subscription",
        "plans",
        "overlay strategists",
        "trial",
        "customer portal",
        "billing portal",
        "upgrade",
        "downgrade",
        "cancel subscription",
        "renewal"
      ],
      "modules": ["Billing"],
      "critical": true
    },
    {
      "name": "Payment",
      "patterns": [
        "payment",
        "stripe",
        "checkout",
        "billing",
        "with card",
        "declined card",
        "payment method",
        "invoice history",
        "dunning"
      ],
      "modules": ["Billing"],
      "critical": true
    },
    {
      "name": "Dashboard",
      "patterns": ["dashboard"],
      "modules": ["Authentication"],
      "critical": true
    }
  ]
