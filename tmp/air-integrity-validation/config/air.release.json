{
  "releaseRules": {
    "failureSeverity": {
      "blocker": ["Blocker"],
      "critical": ["Critical"],
      "warning": ["High", "Medium"]
    },
    "journeyStatus": {
      "critical": ["Critical"],
      "warning": ["Warning", "Partial", "Not Executed"]
    },
    "moduleRisk": {
      "critical": ["High"],
      "warning": ["Medium"]
    },
    "decisions": {
      "allRulesPassed": "GO",
      "criticalJourneyFailed": "NO_GO",
      "criticalFailureFound": "NO_GO",
      "partialExecution": "CONDITIONAL_GO",
      "warningsOnly": "CONDITIONAL_GO"
    },
    "allowPartialRelease": false
  }
}
